                    {
                      "type": "frame",
                      "id": "2zVNK",
                      "name": "fq1",
                      "width": "fill_container",
                      "stroke": {
                        "align": "outside",
                        "thickness": {
                          "bottom": 1
                        },
                        "fill": "#1c1c1c"
                      },
                      "layout": "vertical",
                      "gap": 10,
                      "padding": [
                        24,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "mlN2s",
                          "fill": "#f0f0f0",
                          "content": "Is the Starter plan really free forever?",
                          "fontFamily": "Outfit",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "O0Hyu",
                          "fill": "#6b6b6b",
                          "textGrowth": "fixed-width",
                          "width": 800,
                          "content": "Yes. The Starter plan is permanently free with up to 200 items and 1 warehouse. No credit card required, no trial period.",
                          "lineHeight": 1.6,
                          "fontFamily": "Outfit",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "WJhXP",
                      "name": "fq2",
                      "width": "fill_container",
                      "stroke": {
                        "align": "outside",
                        "thickness": {
                          "bottom": 1
                        },
                        "fill": "#1c1c1c"
                      },
                      "layout": "vertical",
                      "gap": 10,
                      "padding": [
                        24,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "nBbtP",
                          "fill": "#f0f0f0",
                          "content": "Can I import my existing data from Excel or Google Sheets?",
                          "fontFamily": "Outfit",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "9qXx2",
                          "fill": "#6b6b6b",
                          "textGrowth": "fixed-width",
                          "width": 800,
                          "content": "Yes. Obsid supports bulk import from .xlsx files. Upload your existing spreadsheet and your inventory goes live in minutes.",
                          "lineHeight": 1.6,
                          "fontFamily": "Outfit",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "Lbozi",
                      "name": "fq3",
                      "width": "fill_container",
                      "stroke": {
                        "align": "outside",
                        "thickness": {
                          "bottom": 1
                        },
                        "fill": "#1c1c1c"
                      },
                      "layout": "vertical",
                      "gap": 10,
                      "padding": [
                        24,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "7KUEF",
                          "fill": "#f0f0f0",
                          "content": "How does QR loan tracking work?",
                          "fontFamily": "Outfit",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "uXZ5K",
                          "fill": "#6b6b6b",
                          "textGrowth": "fixed-width",
                          "width": 800,
                          "content": "When you create a loan, Obsid generates a unique QR code. Staff scan it to check items out or in. Discharge requests also use QR — external users can submit requests without needing an account.",
                          "lineHeight": 1.6,
                          "fontFamily": "Outfit",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "RWmdG",
                      "name": "fq4",
                      "width": "fill_container",
                      "stroke": {
                        "align": "outside",
                        "thickness": {
                          "bottom": 1
                        },
                        "fill": "#1c1c1c"
                      },
                      "layout": "vertical",
                      "gap": 10,
                      "padding": [
                        24,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "OFkfZ",
                          "fill": "#f0f0f0",
                          "content": "Is Obsid mobile-friendly?",
                          "fontFamily": "Outfit",
                          "fontSize": 16,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "7vSQr",
                          "fill": "#6b6b6b",
                          "textGrowth": "fixed-width",
                          "width": 800,
                          "content": "Obsid is optimized for desktop and tablet workflows. QR scanning and discharge request forms work on any device with a browser — no app install required.",
                          "lineHeight": 1.6,
                          "fontFamily": "Outfit",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "m1B5y",
                      "name": "fq5",
                      "width": "fill_container",
                      "stroke": {
                        "align": "outside",
                        "thickness": {
                          "bottom": 1
                        },
                        "fill": "#1c1c1c"
                      },
                      "layout": "vertical",
                      "gap": 10,
                      "padding": [
                        24,
                        0
                      ],
                      "children": [
                        {
                          "type": "text",
